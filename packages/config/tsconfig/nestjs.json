{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "NestJS application",
  "extends": "./base.json",
  "compilerOptions": {
    "module": "CommonJS",
    "moduleResolution": "node",
    "lib": ["ES2022"],
    "declaration": false,
    "declarationMap": false,
    "noEmit": false,
    "sourceMap": true,
    "removeComments": true,
    "emitDecoratorMetadata": true,
    "experimentalDecorators": true,
    "strictPropertyInitialization": false,
    "isolatedModules": false,
    // ES2022 defaults this to true, which defines class fields instead of
    // assigning them — that erases values class-transformer sets on DTOs.
    "useDefineForClassFields": false
  }
}
