# ─── Runtime ───
NODE_ENV=development
PORT=3001

# ─── Database ───
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wahab_solar

# ─── Auth ───
# Must be at least 32 characters. Generate with: openssl rand -base64 48
JWT_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── HTTP ───
# Comma-separated list of allowed browser origins.
CORS_ORIGIN=http://localhost:3000

# ─── Rate limiting ───
RATE_LIMIT_MAX=100
RATE_LIMIT_TTL=60
